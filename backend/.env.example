# --- MongoDB Atlas ---
MONGODB_URL=mongodb+srv://your_user:your_password@your-cluster.mongodb.net
MONGODB_DB=resume_analyzer

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_MINUTES=1440
ADMIN_EMAILS=you@example.com
INITIAL_ADMIN_EMAIL=admin@gmail.com
# Set this only in the private backend environment; never commit the real password.
INITIAL_ADMIN_PASSWORD=replace-with-a-private-secret

# --- CORS ---
CORS_ORIGINS=http://localhost:5173

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- AI ---
AI_API_KEY=
AI_MODEL_NAME=gemini-3.5-flash-lite
# Update these values from the provider's current pricing before deployment.
AI_PRICING_VERSION=2026-10-rate-card
AI_MODEL_RATES_JSON='{"gemini-3.5-flash-lite":{"input_usd_per_million_tokens":0.0,"output_usd_per_million_tokens":0.0}}'
# Maximum extracted resume text sent to the AI parser. Larger resumes can use spaCy parsing.
MAX_AI_PARSE_CHARS=40000
